{
    "schemaVersion": 1,
    "id": "minty_radar",
    "version": "${version}",
    "name": "MintyRadar",
    "description": "See your enemies before they come",
    "authors": ["patientJeff"],
    "contact": {
        "homepage": "https://github.com/patientJeff/MintyRadar",
        "sources": "https://github.com/patientJeff/MintyRadar",
        "issues": "https://github.com/patientJeff/MintyRadar/issues"
    },
    "license": "MIT",
    "icon": "assets/minty_radar/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.mintyradar.RadarClientMod"
        ],
        "modmenu": [
            "com.mintyradar.ModMenuIntegration"
        ]
    },
    "mixins": [
        "MintyRadar.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader}",
        "fabric-api": "*",
        "minecraft": "${minecraft}",
        "java": ">=${java}"
